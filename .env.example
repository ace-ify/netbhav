# NetBhav — environment (ALL OPTIONAL). The app runs fully with zero keys:
# reference prices + rule-based agent + browser voice. Keys just light it up more.
# Copy to `.env.local` and fill what you have.

# ── Market prices ───────────────────────────────────────────────────────────
# PRIMARY source is a KEYLESS live Agmarknet mirror (works out of the box, no
# signup). Override the base URL only if you self-host it.
MANDI_API_URL=
# SECONDARY (optional): data.gov.in Agmarknet. Must be a key from data.gov.in
# (INDIA), NOT api.data.gov (US, returns 403). Only used to fill mandis the
# keyless source missed. Without any key we still work via the mirror + seed.
DATA_GOV_API_KEY=
# State to pull live prices for (must match Agmarknet spelling).
MANDI_STATE=Uttar Pradesh

# ── AI agent (natural-language chat/voice). No key → rule-based parser. ──────
# Groq (recommended, fast + free tier): https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI-compatible fallback (used if GROQ_API_KEY is unset):
OPENAI_API_KEY=
# Override the model if you like:
LLM_MODEL=
# Point at any OpenAI-compatible endpoint (self-hosted, proxy, or a local mock).
# When set, this wins over the provider URLs above (key optional).
LLM_BASE_URL=

# ── Routing / geocoding (free public services; no key needed) ───────────────
# Self-hosted OSRM for road distances/polylines (default: public demo server).
OSRM_URL=
# Soft geocoding bias so ambiguous Devanagari place names resolve in-region.
# Format: lng,lat,lng,lat (default covers the central-UP / Awadh belt).
GEO_VIEWBOX=

# ── Farmer profile store (persistence) ──────────────────────────────────────
# Without these, profiles live in a local JSON file (data/farmers.json) — fine
# for local dev, but Vercel's filesystem is ephemeral so it resets on redeploy.
# Set both to persist to Supabase (server-side only; use the SERVICE ROLE key).
# One-time SQL in the Supabase SQL editor:
#   create table if not exists netbhav_kv (key text primary key, value jsonb);
SUPABASE_URL=https://xdimhyrhvfwhtbbmywoy.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhkaW1oeXJodmZ3aHRiYm15d295Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDQxNDIxMywiZXhwIjoyMTA1OTkwMjEzfQ.UQ66fss_AhwoymNZ5sJxwU1rQcrPjdUYMCjDxuAQKGQ

# ── WhatsApp / SMS via Twilio (optional omni-channel) ───────────────────────
# Point your Twilio Sandbox "when a message comes in" webhook (POST) at:
#   https://<your-deploy>/api/whatsapp
# No env needed for the demo; add signature validation before production.

# ── LiveKit voice call (real-time WebRTC voice agent; PWA now, PSTN later) ───
# Create a FREE project at https://cloud.livekit.io → Settings → Keys.
# With LiveKit Inference (used by the agent worker) these 3 are the ONLY keys
# needed — STT + LLM + TTS all run through LiveKit, no extra provider keys.
# If these are blank, the app falls back to the built-in browser (Web Speech) voice.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional model tuning for the voice agent (Hindi-capable defaults in code):
LIVEKIT_STT_MODEL=
LIVEKIT_STT_LANG=
LIVEKIT_LLM_MODEL=
LIVEKIT_TTS_MODEL=
LIVEKIT_TTS_VOICE=

